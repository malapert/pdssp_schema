{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/malapert/pdssp_schema/main/schema.json",
  "title": "PDSSP Extension — Mars imagery",
  "description": "PDSSP custom keywords and Mars-imagery service constraints, validated client-side by STAC Browser.",
  "type": "object",
  "allOf": [
    {
      "if": {
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "const": "Feature"
          }
        }
      },
      "then": {
        "$ref": "#/definitions/item"
      }
    }
  ],
  "definitions": {
    "item": {
      "type": "object",
      "required": [
        "geometry",
        "properties",
        "assets",
        "stac_extensions"
      ],
      "properties": {
        "stac_extensions": {
          "type": "array",
          "allOf": [
            {
              "contains": {
                "type": "string",
                "pattern": "stac-extensions.github.io/ssys/"
              }
            },
            {
              "contains": {
                "type": "string",
                "pattern": "stac-extensions.github.io/projection/"
              }
            }
          ]
        },
        "geometry": {
          "not": {
            "type": "null"
          }
        },
        "properties": {
          "$ref": "#/definitions/fields"
        },
        "assets": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/asset"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "properties"
            ],
            "properties": {
              "properties": {
                "required": [
                  "product:type"
                ],
                "properties": {
                  "product:type": {
                    "const": "sp"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "properties": {
                "required": [
                  "cube:dimensions"
                ]
              }
            }
          }
        }
      ]
    },
    "fields": {
      "type": "object",
      "required": [
        "datetime",
        "ssys:targets",
        "ssys:target_class",
        "proj:code"
      ],
      "properties": {
        "ssys:targets": {
          "type": "array",
          "items": {
            "enum": [
              "Mars",
              "Phobos",
              "Deimos"
            ]
          }
        },
        "ssys:target_class": {
          "enum": [
            "planet",
            "satellite"
          ]
        }
      }
    },
    "asset": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "image/x-pds",
            "application/fits",
            "image/tiff; application=geotiff",
            "image/png",
            "image/jpeg"
          ]
        }
      }
    }
  }
}
